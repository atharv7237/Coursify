<%- include('partials/header', { title: 'Authentication' }) %>

<div class="flex-grow flex items-center justify-center p-6 md:p-12">
    <div class="max-w-6xl w-full">
        <%- include('partials/flash') %>

        <!-- Hero Section -->
        <div class="text-center my-10">
            <h1 class="text-6xl md:text-8xl font-black text-orange-500 tracking-tight">
                FLY HIGH.
            </h1>
            <p class="text-2xl text-white font-semibold mt-4">
                One Goal. One Roadmap. One Step At A Time.
            </p>
            <p class="text-zinc-400 mt-4 max-w-2xl mx-auto text-base md:text-lg">
                Tell us where you want to go and we'll build a personalized AI learning path to get you there.
            </p>
        </div>

        <!-- Login & Register Cards -->
        <div class="grid md:grid-cols-2 gap-8 mt-10">
            <!-- Login -->
            <div class="bg-zinc-900/90 p-8 rounded-3xl border border-orange-500/20 shadow-2xl flex flex-col justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-orange-500 mb-6">
                        Login
                    </h2>
                    <form action="/auth/login" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1.5 uppercase">Email Address</label>
                            <input type="email" name="email" required placeholder="you@example.com"
                                class="w-full bg-zinc-800/80 border border-zinc-700/80 p-4 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1.5 uppercase">Password</label>
                            <input type="password" name="password" required placeholder="••••••••"
                                class="w-full bg-zinc-800/80 border border-zinc-700/80 p-4 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <div class="flex items-center justify-end py-1">
                            <a href="/auth/getmail" class="text-sm text-zinc-400 hover:text-orange-400 transition">
                                Forgot Password?
                            </a>
                        </div>

                        <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 active:scale-[0.99] transition py-4 rounded-xl font-bold text-white shadow-lg shadow-orange-500/20">
                            Login to Coursify
                        </button>
                    </form>
                </div>
            </div>

            <!-- Register -->
            <div class="bg-zinc-900/90 p-8 rounded-3xl border border-orange-500/20 shadow-2xl flex flex-col justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-orange-500 mb-6">
                        Register
                    </h2>
                    <form action="/auth/register" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1.5 uppercase">Full Name</label>
                            <input type="text" name="fullname" required placeholder="John Doe"
                                class="w-full bg-zinc-800/80 border border-zinc-700/80 p-4 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1.5 uppercase">Email Address</label>
                            <input type="email" name="email" required placeholder="you@example.com"
                                class="w-full bg-zinc-800/80 border border-zinc-700/80 p-4 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1.5 uppercase">Password</label>
                            <input type="password" name="password" required minlength="6" placeholder="At least 6 characters"
                                class="w-full bg-zinc-800/80 border border-zinc-700/80 p-4 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 active:scale-[0.99] transition py-4 rounded-xl font-bold text-white shadow-lg shadow-orange-500/20 mt-4">
                            Create Free Account
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
