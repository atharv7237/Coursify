<%- include('partials/header', { title: 'Reset Password' }) %>

<div class="flex-grow flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-zinc-900/90 border border-orange-500/20 rounded-3xl p-8 shadow-2xl">
        <%- include('partials/flash') %>

        <h1 class="text-3xl font-black text-orange-500 mb-2 mt-2">
            Reset Password
        </h1>

        <p class="text-zinc-400 text-sm mb-6 leading-relaxed">
            Create a new strong password for your account.
        </p>

        <form action="/auth/reset-password" method="POST" class="space-y-5">
            <div>
                <label class="block mb-1.5 text-xs font-semibold text-zinc-300 uppercase">
                    New Password
                </label>
                <input
                    type="password"
                    name="newpass"
                    required
                    minlength="6"
                    placeholder="At least 6 characters"
                    class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/80 border border-zinc-700/80 text-white placeholder-zinc-500 focus:ring-2 focus:ring-orange-500 focus:outline-none transition">
            </div>

            <button
                type="submit"
                class="w-full bg-orange-500 hover:bg-orange-600 active:scale-[0.99] transition py-3.5 rounded-xl font-bold text-white shadow-lg shadow-orange-500/20">
                Update Password
            </button>
        </form>

        <div class="mt-6 text-center border-t border-zinc-800 pt-4">
            <a href="/" class="text-sm text-zinc-400 hover:text-orange-400 transition">
                ← Back to Login
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
