<%- include('partials/header', { title: 'My Roadmaps' }) %>
<%- include('partials/nav') %>

<main class="flex-grow max-w-7xl mx-auto px-6 py-12 w-full">
    <%- include('partials/flash') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
        <div>
            <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">
                My Learning Roadmaps
            </h1>
            <p class="text-zinc-400 mt-2 text-base">
                Track your goals and continue your learning milestones.
            </p>
        </div>

        <a href="/roadmap/home" class="inline-flex items-center space-x-2 bg-orange-500 hover:bg-orange-600 active:scale-95 text-white font-semibold px-5 py-3 rounded-xl transition shadow-lg shadow-orange-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Create New Roadmap</span>
        </a>
    </div>

    <% if (roadmaps && roadmaps.length > 0) { %>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% roadmaps.forEach((roadmap) => { %>
                <div class="bg-zinc-900/90 p-6 rounded-2xl border border-orange-500/20 shadow-xl flex flex-col justify-between hover:border-orange-500/40 transition">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-md bg-orange-500/10 border border-orange-500/30 text-orange-400">
                                <%= roadmap.level %>
                            </span>
                            <span class="text-xs text-zinc-500">
                                <%= new Date(roadmap.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                        </div>

                        <h2 class="text-xl font-bold text-white mb-2 line-clamp-2">
                            <%= roadmap.goal %>
                        </h2>

                        <p class="text-sm text-zinc-400">
                            ⏱️ <%= roadmap.hours %> hrs/day • <%= roadmap.generatedroadmap && roadmap.generatedroadmap.duration ? roadmap.generatedroadmap.duration : 'Custom' %>
                        </p>
                    </div>

                    <div class="flex items-center justify-between gap-3 mt-6 pt-4 border-t border-zinc-800">
                        <a href="/roadmap/dashboards/<%= roadmap._id %>" class="flex-grow text-center bg-orange-500 hover:bg-orange-600 text-white font-medium py-2.5 px-4 rounded-xl transition text-sm">
                            View Roadmap
                        </a>

                        <form action="/roadmap/delete/<%= roadmap._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this roadmap?');">
                            <button type="submit" class="bg-red-500/10 hover:bg-red-500/20 text-red-400 p-2.5 rounded-xl border border-red-500/30 transition text-sm" title="Delete Roadmap">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-20 bg-zinc-900/40 rounded-3xl border border-zinc-800 p-8">
            <div class="w-16 h-16 bg-orange-500/10 text-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-orange-500/20">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">No Roadmaps Created Yet</h3>
            <p class="text-zinc-400 max-w-md mx-auto mb-6 text-sm">
                You haven't generated any learning roadmaps yet. Choose your goal and let AI create a personalized learning track!
            </p>
            <a href="/roadmap/home" class="inline-flex items-center space-x-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-lg shadow-orange-500/20">
                <span>Create Your First Roadmap</span>
            </a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
