<%- include('partials/header', { title: 'Verify OTP' }) %>

<div class="flex-grow flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-zinc-900/90 border border-orange-500/20 rounded-3xl p-8 shadow-2xl">
        <%- include('partials/flash') %>

        <h1 class="text-3xl font-black text-orange-500 mb-2 mt-2">
            Verify Code
        </h1>

        <p class="text-zinc-400 text-sm mb-6 leading-relaxed">
            We've sent a 6-digit verification code to your email. Enter it below to reset your password.
        </p>

        <form action="/auth/verify-otp" method="POST" class="space-y-5">
            <div>
                <label class="block mb-1.5 text-xs font-semibold text-zinc-300 uppercase">
                    6-Digit Verification Code
                </label>
                <input
                    type="text"
                    name="otp"
                    required
                    maxlength="6"
                    minlength="6"
                    pattern="[0-9]{6}"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    placeholder="••••••"
                    autofocus
                    class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/80 border border-zinc-700/80 text-white placeholder-zinc-500 text-center tracking-[0.5em] text-2xl font-mono focus:ring-2 focus:ring-orange-500 focus:outline-none transition">
            </div>

            <button
                type="submit"
                class="w-full bg-orange-500 hover:bg-orange-600 active:scale-[0.99] transition py-3.5 rounded-xl font-bold text-white shadow-lg shadow-orange-500/20">
                Verify Code
            </button>
        </form>

        <div class="mt-6 flex items-center justify-between text-xs text-zinc-400 border-t border-zinc-800 pt-4">
            <a href="/auth/forgot-password" class="hover:text-orange-400 transition">
                ← Change Email
            </a>
            <a href="/auth/resend-otp" class="text-orange-500 hover:text-orange-400 font-semibold transition">
                Resend Code
            </a>
        </div>

        <div class="mt-4 text-center">
            <a href="/" class="text-xs text-zinc-500 hover:text-zinc-300 transition">
                Back to Login
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
