
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP | Coursify</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-950 text-white min-h-screen flex items-center justify-center">

    <div class="w-full max-w-md bg-zinc-900 border border-orange-500/20 rounded-2xl p-8 shadow-lg">

        <h1 class="text-3xl font-bold text-orange-500 mb-3">
            Verify OTP
        </h1>

        <p class="text-zinc-400 mb-8">
            We've sent a 6-digit verification code to your registered email address.
            Enter it below to continue.
        </p>

        <form action="/auth/verify-otp" method="POST" class="space-y-6">

            <div>
                <label class="block mb-2 text-sm font-medium">
                    Verification Code
                </label>

                <input
                    type="text"
                    name="otp"
                    maxlength="6"
                    minlength="6"
                    pattern="[0-9]{6}"
                    required
                    placeholder="Enter 6-digit OTP"
                    class="w-full text-center tracking-[0.5em] text-2xl px-4 py-3 rounded-lg bg-zinc-800 border border-zinc-700 focus:border-orange-500 focus:outline-none">
            </div>

            <button
                type="submit"
                class="w-full bg-orange-500 hover:bg-orange-600 transition py-3 rounded-lg font-semibold">
                Verify OTP
            </button>

        </form>

        <div class="mt-6 flex justify-between text-sm">

            <a href="/auth/forgot-password"
               class="text-orange-400 hover:underline">
                ← Change Email
            </a>

            <a href="/auth/resend-otp"
               class="text-orange-400 hover:underline">
                Resend OTP
            </a>

        </div>

    </div>

</body>
</html>
